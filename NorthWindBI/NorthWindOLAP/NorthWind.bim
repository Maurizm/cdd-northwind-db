{
  "name": "NorthWindOLAP",
  "id": "NorthWindOLAP",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "es-ES",
    "dataSources": [
      {
        "name": "NorthWindDW",
        "type": "provider",
        "connectionString": "Provider=MSOLEDBSQL;Data Source=localhost;Initial Catalog=NorthWindDW;Integrated Security=SSPI;Persist Security Info=False",
        "impersonationMode": "impersonateServiceAccount"
      }
    ],
    "tables": [
      {
        "name": "Calendario",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Año",
            "dataType": "int64",
            "sourceColumn": "Año",
            "summarizeBy": "none"
          },
          {
            "name": "Trimestre",
            "dataType": "string",
            "sourceColumn": "Trimestre",
            "summarizeBy": "none",
            "sortByColumn": "TrimestreNumero"
          },
          {
            "name": "TrimestreNumero",
            "dataType": "int64",
            "sourceColumn": "TrimestreNumero",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "sortByColumn": "MesNumero"
          },
          {
            "name": "MesNumero",
            "dataType": "int64",
            "sourceColumn": "MesNumero",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "MesAño",
            "dataType": "string",
            "sourceColumn": "MesAño",
            "summarizeBy": "none",
            "sortByColumn": "OrdenMesAño"
          },
          {
            "name": "OrdenMesAño",
            "dataType": "int64",
            "sourceColumn": "OrdenMesAño",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT [DateKey],\n       CASE WHEN [DateKey] <> -1 THEN [FullDate] END AS [Fecha],\n       CASE WHEN [DateKey] <> -1 THEN [Year] END AS [Año],\n       [QuarterName] AS [Trimestre], [Quarter] AS [TrimestreNumero],\n       [MonthName] AS [Mes], [MonthOfYear] AS [MesNumero],\n       CASE WHEN [DateKey] = -1 THEN N'Desconocido'\n            ELSE CONVERT(NVARCHAR(7), [FullDate], 126) END AS [MesAño],\n       CASE WHEN [DateKey] = -1 THEN 0\n            ELSE [Year] * 100 + [MonthOfYear] END AS [OrdenMesAño]\nFROM [dbo].[DimDate]"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Calendario",
            "levels": [
              {
                "name": "Año",
                "ordinal": 0,
                "column": "Año"
              },
              {
                "name": "Trimestre",
                "ordinal": 1,
                "column": "Trimestre"
              },
              {
                "name": "Mes",
                "ordinal": 2,
                "column": "Mes"
              },
              {
                "name": "Fecha",
                "ordinal": 3,
                "column": "Fecha"
              }
            ]
          }
        ]
      },
      {
        "name": "Clientes",
        "columns": [
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Cliente",
            "dataType": "string",
            "sourceColumn": "Cliente",
            "summarizeBy": "none"
          },
          {
            "name": "Pais",
            "dataType": "string",
            "sourceColumn": "Pais",
            "summarizeBy": "none",
            "dataCategory": "Country"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince"
          },
          {
            "name": "Ciudad",
            "dataType": "string",
            "sourceColumn": "Ciudad",
            "summarizeBy": "none",
            "dataCategory": "City"
          }
        ],
        "partitions": [
          {
            "name": "Clientes",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT c.[CustomerKey], c.[CompanyName] AS [Cliente],\n       g.[Country] AS [Pais], g.[Region] AS [Region], g.[City] AS [Ciudad]\nFROM [dbo].[DimCustomer] c\nLEFT JOIN [dbo].[DimGeography] g ON c.[GeographyKey] = g.[GeographyKey]"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Ubicacion del Cliente",
            "levels": [
              {
                "name": "Pais",
                "ordinal": 0,
                "column": "Pais"
              },
              {
                "name": "Region",
                "ordinal": 1,
                "column": "Region"
              },
              {
                "name": "Ciudad",
                "ordinal": 2,
                "column": "Ciudad"
              },
              {
                "name": "Cliente",
                "ordinal": 3,
                "column": "Cliente"
              }
            ]
          }
        ]
      },
      {
        "name": "Productos",
        "columns": [
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Producto",
            "dataType": "string",
            "sourceColumn": "Producto",
            "summarizeBy": "none"
          },
          {
            "name": "Categoria",
