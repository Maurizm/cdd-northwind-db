        ],
        "partitions": [
          {
            "name": "Productos",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT [ProductKey], [ProductName] AS [Producto],\n       [CategoryName] AS [Categoria], [ProductStatus] AS [Estado]\nFROM [dbo].[DimProduct]"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Catalogo",
            "levels": [
              {
                "name": "Categoria",
                "ordinal": 0,
                "column": "Categoria"
              },
              {
                "name": "Producto",
                "ordinal": 1,
                "column": "Producto"
              }
            ]
          }
        ]
      },
      {
        "name": "Vendedores",
        "columns": [
          {
            "name": "EmployeeKey",
            "dataType": "int64",
            "sourceColumn": "EmployeeKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Vendedor",
            "dataType": "string",
            "sourceColumn": "Vendedor",
            "summarizeBy": "none"
          },
          {
            "name": "Cargo",
            "dataType": "string",
            "sourceColumn": "Cargo",
            "summarizeBy": "none"
          },
          {
            "name": "Supervisor",
            "dataType": "string",
            "sourceColumn": "Supervisor",
            "summarizeBy": "none"
          },
          {
            "name": "Pais",
            "dataType": "string",
            "sourceColumn": "Pais",
            "summarizeBy": "none",
            "dataCategory": "Country"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince"
          },
          {
            "name": "Ciudad",
            "dataType": "string",
            "sourceColumn": "Ciudad",
            "summarizeBy": "none",
            "dataCategory": "City"
          }
        ],
        "partitions": [
          {
            "name": "Vendedores",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT e.[EmployeeKey], e.[FullName] AS [Vendedor], e.[Title] AS [Cargo],\n       e.[ManagerName] AS [Supervisor], g.[Country] AS [Pais],\n       g.[Region] AS [Region], g.[City] AS [Ciudad]\nFROM [dbo].[DimEmployee] e\nLEFT JOIN [dbo].[DimGeography] g ON e.[GeographyKey] = g.[GeographyKey]"
            }
          }
        ]
      },
      {
        "name": "Proveedores",
        "columns": [
          {
            "name": "SupplierKey",
            "dataType": "int64",
            "sourceColumn": "SupplierKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Proveedor",
            "dataType": "string",
            "sourceColumn": "Proveedor",
            "summarizeBy": "none"
          },
          {
            "name": "Pais",
            "dataType": "string",
            "sourceColumn": "Pais",
            "summarizeBy": "none",
            "dataCategory": "Country"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince"
          },
          {
            "name": "Ciudad",
            "dataType": "string",
            "sourceColumn": "Ciudad",
            "summarizeBy": "none",
            "dataCategory": "City"
          }
        ],
        "partitions": [
          {
            "name": "Proveedores",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT s.[SupplierKey], s.[CompanyName] AS [Proveedor],\n       g.[Country] AS [Pais], g.[Region] AS [Region], g.[City] AS [Ciudad]\nFROM [dbo].[DimSupplier] s\nLEFT JOIN [dbo].[DimGeography] g ON s.[GeographyKey] = g.[GeographyKey]"
            }
          }
        ]
      },
      {
        "name": "Transportistas",
        "columns": [
          {
            "name": "ShipperKey",
            "dataType": "int64",
            "sourceColumn": "ShipperKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Transportista",
            "dataType": "string",
            "sourceColumn": "Transportista",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Transportistas",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT [ShipperKey], [CompanyName] AS [Transportista]\nFROM [dbo].[DimShipper]"
            }
          }
        ]
      },
      {
        "name": "Ventas",
        "columns": [
          {
            "name": "SalesKey",
            "dataType": "int64",
            "sourceColumn": "SalesKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "Pedido",
            "dataType": "int64",
            "sourceColumn": "Pedido",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Nivel de Descuento",
            "dataType": "string",
            "sourceColumn": "Nivel de Descuento",
            "summarizeBy": "none",
            "sortByColumn": "OrdenDescuento"
          },
          {
            "name": "OrdenDescuento",
            "dataType": "int64",
            "sourceColumn": "OrdenDescuento",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OrderID",
            "dataType": "int64",
            "sourceColumn": "OrderID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OrderLineNum",
            "dataType": "int64",
            "sourceColumn": "OrderLineNum",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OrderDateKey",
            "dataType": "int64",
            "sourceColumn": "OrderDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ShippedDateKey",
            "dataType": "int64",
            "sourceColumn": "ShippedDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "RequiredDateKey",
            "dataType": "int64",
            "sourceColumn": "RequiredDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "EmployeeKey",
            "dataType": "int64",
            "sourceColumn": "EmployeeKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "SupplierKey",
            "dataType": "int64",
            "sourceColumn": "SupplierKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ShipperKey",
            "dataType": "int64",
            "sourceColumn": "ShipperKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DiasHastaEnvio",
            "dataType": "int64",
            "sourceColumn": "DiasHastaEnvio",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "GrossAmount",
            "dataType": "decimal",
            "sourceColumn": "GrossAmount",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00"
          },
          {
            "name": "DiscountAmount",
            "dataType": "decimal",
            "sourceColumn": "DiscountAmount",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00"
          },
          {
            "name": "NetAmount",
            "dataType": "decimal",
            "sourceColumn": "NetAmount",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00"
          },
          {
            "name": "AllocatedFreight",
            "dataType": "decimal",
            "sourceColumn": "AllocatedFreight",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "Ventas",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "NorthWindDW",
              "query": "SELECT f.[SalesKey], f.[OrderID], f.[OrderLineNum],\n       f.[OrderID] AS [Pedido],\n       f.[OrderDateKey], f.[ShippedDateKey], f.[RequiredDateKey],\n       f.[CustomerKey], f.[EmployeeKey], f.[ProductKey],\n       f.[SupplierKey], f.[ShipperKey], f.[Quantity],\n       f.[GrossAmount], f.[DiscountAmount], f.[NetAmount], f.[AllocatedFreight],\n       CASE WHEN d.[Pct] = 0 THEN N'Sin descuento'\n            WHEN d.[Pct] <= 5 THEN N'1-5%'\n            WHEN d.[Pct] <= 10 THEN N'6-10%'\n            WHEN d.[Pct] <= 15 THEN N'11-15%'\n            WHEN d.[Pct] <= 20 THEN N'16-20%'\n            ELSE N'Más de 20%' END AS [Nivel de Descuento],\n       CASE WHEN d.[Pct] = 0 THEN 0 WHEN d.[Pct] <= 5 THEN 1\n            WHEN d.[Pct] <= 10 THEN 2 WHEN d.[Pct] <= 15 THEN 3\n            WHEN d.[Pct] <= 20 THEN 4 ELSE 5 END AS [OrdenDescuento],\n       CASE WHEN f.[OrderDateKey] <> -1 AND f.[ShippedDateKey] <> -1\n            THEN DATEDIFF(DAY, od.[FullDate], sd.[FullDate]) END\n            AS [DiasHastaEnvio]\nFROM [dbo].[FactSales] f\nLEFT JOIN [dbo].[DimDate] od ON f.[OrderDateKey] = od.[DateKey]\nLEFT JOIN [dbo].[DimDate] sd ON f.[ShippedDateKey] = sd.[DateKey]\nCROSS APPLY (SELECT CAST(ROUND(f.[Discount] * 100, 0) AS INT) AS [Pct]) d"
            }
          }
        ],
        "measures": [
          {
            "name": "Ventas Brutas",
            "expression": "SUM(Ventas[GrossAmount])",
            "formatString": "#,0.00",
            "displayFolder": "Importes",
            "description": "Importe antes de descuentos; la moneda no esta identificada en el origen."
          },
          {
            "name": "Descuentos",
            "expression": "SUM(Ventas[DiscountAmount])",
            "formatString": "#,0.00",
            "displayFolder": "Importes",
            "description": "Importe de descuentos concedidos, no porcentaje."
          },
          {
            "name": "Ventas Netas",
            "expression": "SUM(Ventas[NetAmount])",
            "formatString": "#,0.00",
            "displayFolder": "Importes",
            "description": "Importe despues de descuentos, sin agregar flete."
          },
          {
            "name": "Unidades Vendidas",
            "expression": "SUM(Ventas[Quantity])",
            "formatString": "#,0",
            "displayFolder": "Actividad",
            "description": "Unidades de las lineas de pedido en el contexto seleccionado."
          },
          {
            "name": "Pedidos",
            "expression": "DISTINCTCOUNT(Ventas[OrderID])",
            "formatString": "#,0",
            "displayFolder": "Actividad",
            "description": "Pedidos distintos. No es aditivo entre productos o categorias."
          },
          {
            "name": "Ticket Promedio",
            "expression": "DIVIDE([Ventas Netas], [Pedidos])",
            "formatString": "#,0.00",
            "displayFolder": "Importes",
            "description": "Ventas netas por pedido dentro del contexto seleccionado."
          },
          {
            "name": "Tasa de Descuento",
            "expression": "DIVIDE([Descuentos], [Ventas Brutas])",
            "formatString": "0.0%",
            "displayFolder": "Importes",
            "description": "Descuento efectivo ponderado por importe bruto."
          },
          {
            "name": "Flete Asignado",
            "expression": "SUM(Ventas[AllocatedFreight])",
            "formatString": "#,0.00",
            "displayFolder": "Logistica",
            "description": "Flete distribuido entre lineas por el ETL; puede tener redondeo monetario."
          },
          {
            "name": "Pedidos Enviados",
            "expression": "CALCULATE([Pedidos], KEEPFILTERS(Ventas[ShippedDateKey] <> -1))",
            "formatString": "#,0",
            "displayFolder": "Logistica",
            "description": "Pedidos con fecha de envio conocida."
          },
          {
            "name": "Dias Promedio Hasta Envio",
            "expression": "AVERAGEX(VALUES(Ventas[OrderID]), CALCULATE(MAX(Ventas[DiasHastaEnvio])))",
            "formatString": "0.0",
            "displayFolder": "Logistica",
            "description": "Dias pedido-envio, ponderados por pedido, no por linea. No mide entrega al cliente; omite fechas desconocidas."
          },
          {
            "name": "Ventas por Fecha de Envio",
            "expression": "CALCULATE([Ventas Netas], USERELATIONSHIP(Ventas[ShippedDateKey], Calendario[DateKey]))",
            "formatString": "#,0.00",
            "displayFolder": "Fechas",
            "description": "Ventas netas agrupadas por fecha de envio."
          },
          {
            "name": "Ventas por Fecha Requerida",
            "expression": "CALCULATE([Ventas Netas], USERELATIONSHIP(Ventas[RequiredDateKey], Calendario[DateKey]))",
            "formatString": "#,0.00",
            "displayFolder": "Fechas",
            "description": "Ventas netas agrupadas por fecha requerida."
          },
          {
            "name": "Clientes Activos",
            "expression": "DISTINCTCOUNT(Ventas[CustomerKey])",
            "formatString": "#,0",
            "displayFolder": "Actividad",
            "description": "Clientes distintos con al menos una linea de pedido en el contexto."
          },
          {
            "name": "Precio Promedio",
            "expression": "DIVIDE([Ventas Brutas], [Unidades Vendidas])",
            "formatString": "#,0.00",
            "displayFolder": "Importes",
            "description": "Precio unitario medio ponderado por unidades, antes de descuentos."
          },
          {
            "name": "Ventas Año Anterior",
            "expression": "VAR UltimaVenta = CALCULATE(MAX(Ventas[OrderDateKey]), REMOVEFILTERS())\nRETURN\n    IF(HASONEVALUE(Calendario[MesAño]) && MIN(Calendario[DateKey]) <= UltimaVenta,\n        VAR FechasPrevias =\n            SELECTCOLUMNS(\n                FILTER(VALUES(Calendario[Fecha]), NOT ISBLANK(Calendario[Fecha])),\n                \"Fecha\", EDATE(Calendario[Fecha], -12))\n        RETURN\n            CALCULATE([Ventas Netas], REMOVEFILTERS(Calendario),\n                      TREATAS(FechasPrevias, Calendario[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "Fechas",
            "description": "Ventas netas del mismo mes del año anterior (fecha de pedido). Solo se calcula para un mes dentro del rango de ventas."
          },
          {
            "name": "Crecimiento Interanual",
            "expression": "DIVIDE([Ventas Netas] - [Ventas Año Anterior], [Ventas Año Anterior])",
            "formatString": "0.0%",
            "displayFolder": "Fechas",
            "description": "Variacion contra el mismo mes del año anterior; vacio si no hay mes previo."
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Ventas_OrderDateKey",
        "fromTable": "Ventas",
        "fromColumn": "OrderDateKey",
        "fromCardinality": "many",
        "toTable": "Calendario",
        "toColumn": "DateKey",
        "toCardinality": "one",
        "isActive": true,
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Ventas_ShippedDateKey",
        "fromTable": "Ventas",
        "fromColumn": "ShippedDateKey",
        "fromCardinality": "many",
        "toTable": "Calendario",
        "toColumn": "DateKey",
        "toCardinality": "one",
        "isActive": false,
        "crossFilteringBehavior": "oneDirection"
      },
      {
