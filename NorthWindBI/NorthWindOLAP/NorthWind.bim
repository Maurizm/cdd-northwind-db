        "fromTable": "Ventas",
        "fromColumn": "RequiredDateKey",
        "fromCardinality": "many",
        "toTable": "Calendario",
        "toColumn": "DateKey",
        "toCardinality": "one",
        "isActive": false,
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Ventas_CustomerKey",
        "fromTable": "Ventas",
        "fromColumn": "CustomerKey",
        "fromCardinality": "many",
        "toTable": "Clientes",
        "toColumn": "CustomerKey",
        "toCardinality": "one",
        "isActive": true,
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Ventas_ProductKey",
        "fromTable": "Ventas",
        "fromColumn": "ProductKey",
        "fromCardinality": "many",
        "toTable": "Productos",
        "toColumn": "ProductKey",
        "toCardinality": "one",
        "isActive": true,
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Ventas_EmployeeKey",
        "fromTable": "Ventas",
        "fromColumn": "EmployeeKey",
        "fromCardinality": "many",
        "toTable": "Vendedores",
        "toColumn": "EmployeeKey",
        "toCardinality": "one",
        "isActive": true,
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Ventas_SupplierKey",
        "fromTable": "Ventas",
