    "targetVisualNames": [
      "resumen_trend",
      "resumen_trend_orders"
    ],
    "suppressData": true,
    "suppressDisplay": false,
    "suppressActiveSection": true,
    "applyOnlyToTargetVisuals": false
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "resumen",
    "sections": {
      "resumen": {
        "visualContainers": {
          "resumen_trend": {
            "singleVisual": {}
          },
          "resumen_trend_orders": {
            "singleVisual": {
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
}
